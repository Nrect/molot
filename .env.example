# Molot configuration — env vars only, validated fail-fast at startup (BOOK_AUDIT rule 55).
# This file doubles as the env source for the `app` service in docker-compose
# (hostnames below are compose service names). For `go run` outside compose,
# replace postgres/otel-collector with localhost.

# --- Platform policy ---------------------------------------------------------
# Single platform currency; ListAuction rejects anything else (ErrUnsupportedCurrency).
PLATFORM_CURRENCY=USD
# Platform commission snapshotted onto invoices at issue time (basis points, 1 bp = 0.01%).
COMMISSION_BASIS_POINTS=1000
# Invoice payment deadline: due_at = issued_at + PAYMENT_TERM (prod 48h, seconds in tests).
PAYMENT_TERM=48h
# Listing policy snapshotted onto auctions at listing time (§2.1):
# bids at or above this amount (minor units) require a verified bidder...
VERIFY_ABOVE_MINOR=100000
# ...and a bid landing within SNIPE_WINDOW of the deadline extends it by
# SNIPE_EXTENSION, at most SNIPE_MAX_EXTENSIONS times.
SNIPE_WINDOW=5m
SNIPE_EXTENSION=5m
SNIPE_MAX_EXTENSIONS=3

# --- PSP (fake adapter) ------------------------------------------------------
# success | decline | flaky (flaky: first Charge fails with a network error, retry succeeds).
PSP_MODE=success

# --- Auth --------------------------------------------------------------------
# jwks (OIDC provider) | local-hs256 (local dev/test fake through the same middleware path).
AUTH_MODE=local-hs256
# HS256 signing secret for AUTH_MODE=local-hs256 only. Never use in prod.
AUTH_HS256_SECRET=dev-secret-change-me

# --- Storage -----------------------------------------------------------------
DATABASE_URL=postgres://molot:molot@postgres:5432/molot?sslmode=disable

# --- Observability -----------------------------------------------------------
# OTLP gRPC endpoint (traces + metrics) — the otel-collector service.
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
# json (prod/compose) | text (local console).
LOG_FORMAT=json

# --- Settlement saga ---------------------------------------------------------
# Relisted auction window: starts_at = now + RELIST_DELAY, ends_at = starts_at + RELIST_DURATION.
RELIST_DELAY=1m
RELIST_DURATION=24h

# --- Workers -----------------------------------------------------------------
# ClosingWorker tick (auctions past ends_at).
CLOSING_POLL_INTERVAL=1s
# ExpiryWorker tick (invoices past due_at).
EXPIRY_POLL_INTERVAL=5s
# Optional per-replica random tick phase; enable only if lock contention becomes measurable (§10).
# CLOSING_POLL_JITTER=500ms

# --- HTTP --------------------------------------------------------------------
HTTP_PORT=8080
